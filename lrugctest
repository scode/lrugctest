#!/bin/bash
#
# Build the LRU GC stress test with Gradle and run it on a user-chosen JDK with collector-specific flags.
#
# The workload deliberately does not run under `./gradlew run`: that would run it on the build's toolchain JDK and
# ignore JAVA_HOME, which defeats the point of a tool for comparing collectors across JDK builds. Instead Gradle only
# assembles the classpath (installDist) and the script launches the JVM itself.
#
# Environment:
#   LRUGCTEST_COLLECTOR  g1 (default), z, shenandoah, or throughput.
#   JAVABIN              Explicit path to the java binary. Wins over JAVA_HOME.
#   JAVA_HOME            JDK to use when JAVABIN is unset. Falls back to `java` on PATH.
#   _JAVA_OPTIONS        Read by the JVM itself and applied after our flags, so it can override them. To change the
#                        heap, override both -Xms and -Xmx; a lone -Xmx below our -Xms2G makes the JVM refuse to start.
#
# All arguments are passed through to the workload; see `./lrugctest --help`.

set -euo pipefail

# The build emits Java 25 bytecode (the toolchain in app/build.gradle.kts), and the collector modes below (generational-only ZGC, generational Shenandoah as
# a product mode) assume JDK 25 or newer.
MIN_JAVA_MAJOR=25

# Resolve symlinks by hand so the script works when linked into a bin directory. `readlink -f` would do this in one
# step but is missing on older macOS. CDPATH is cleared because `cd` into a CDPATH match prints the directory, which
# would end up in the captured path.
script_dir () {
    local src="${BASH_SOURCE[0]}" dir
    while [ -L "$src" ]; do
        dir="$(CDPATH= cd -- "$(dirname -- "$src")" >/dev/null && pwd)"
        src="$(readlink -- "$src")"
        case "$src" in
            /*) ;;
            *) src="$dir/$src" ;;
        esac
    done
    CDPATH= cd -- "$(dirname -- "$src")" >/dev/null && pwd
}

SCRIPT_DIR="$(script_dir)"

# Where `installDist` puts the application jar and its dependencies, and the entry point it would otherwise write into
# a start script. MAIN_CLASS must match `application.mainClass` in app/build.gradle.kts.
INSTALL_LIB="$SCRIPT_DIR/app/build/install/app/lib"
MAIN_CLASS="org.scode.lrugctest.cmdline.Main"

java_bin () {
    if [ -n "${JAVABIN:-}" ]; then
        echo "$JAVABIN"
    elif [ -n "${JAVA_HOME:-}" ]; then
        echo "$JAVA_HOME/bin/java"
    else
        echo "java"
    fi
}

# Prints the JVM's system properties as reported by `-XshowSettings:properties`, from which the version check and the
# Gradle wrapper's JAVA_HOME are both read.
#
# The probe JVM runs without the user's JVM option variables. Those are meant for the real run: flags that need our
# unlock options would make the probe fail, and a -javaagent (such as jHiccup) would otherwise start twice. If the
# probe fails anyway, its output goes to stderr so the user sees the JVM's own error.
java_settings () {
    local out
    if ! out="$(env -u _JAVA_OPTIONS -u JAVA_TOOL_OPTIONS -u JDK_JAVA_OPTIONS "$1" -XshowSettings:properties -version 2>&1)"; then
        echo "$out" >&2
        return 1
    fi
    echo "$out"
}

# Prints the value of one property, matched by exact name, from java_settings output on stdin. Reads all of its input
# rather than stopping at the match, so the producer never sees a closed pipe under pipefail.
java_property () {
    awk -F' = ' -v key="$1" '{ k = $1; sub(/^ +/, "", k) } k == key && !found { print $2; found = 1 }'
}

# Collector selection plus the flags shared across collectors. Appends to the JVMOPTS array.
build_jvmopts () {
    local collector="${LRUGCTEST_COLLECTOR:-g1}"

    # Lets users pass experimental or diagnostic flags through _JAVA_OPTIONS without editing this script.
    JVMOPTS+=(-XX:+UnlockExperimentalVMOptions -XX:+UnlockDiagnosticVMOptions)

    case "$collector" in
        g1)
            JVMOPTS+=(-XX:+UseG1GC -XX:MaxGCPauseMillis=50 -XX:GCPauseIntervalMillis=75)
            ;;
        z)
            # ZGC is generational-only since JDK 24 (JEP 490), so no mode flag is needed or accepted.
            JVMOPTS+=(-XX:+UseZGC)
            ;;
        shenandoah)
            # Generational mode is a product feature since JDK 25 (JEP 521). An LRU workload is hostile to
            # generational collection, which is exactly what this test wants to exercise.
            JVMOPTS+=(-XX:+UseShenandoahGC -XX:ShenandoahGCMode=generational)
            ;;
        throughput)
            JVMOPTS+=(-XX:+UseParallelGC)
            ;;
        *)
            echo "unknown collector: $collector (expected g1, z, shenandoah, or throughput)" >&2
            exit 1
            ;;
    esac

    JVMOPTS+=(
        -XX:+CITime
        -XX:+PrintCommandLineFlags
        -Xlog:gc,safepoint
        -Djava.net.preferIPv4Stack=true
        -Xms2G
        -Xmx2G
        -Xss256k
    )
}

JAVA="$(java_bin)"
JAVA_SETTINGS="$(java_settings "$JAVA" || true)"
# Feature release number, e.g. 25. Pre-9 JDKs report "1.8" and come out as 1, which still fails the check as intended.
JAVA_MAJOR="$(echo "$JAVA_SETTINGS" | java_property java.specification.version | cut -d. -f1)"
if [ -z "$JAVA_MAJOR" ]; then
    echo "could not determine the version of $JAVA; set JAVA_HOME or JAVABIN to a working JDK" >&2
    exit 1
fi
if [ "$JAVA_MAJOR" -lt "$MIN_JAVA_MAJOR" ]; then
    echo "$JAVA is JDK $JAVA_MAJOR; JDK $MIN_JAVA_MAJOR or newer is required (set JAVA_HOME or JAVABIN)" >&2
    exit 1
fi

JVMOPTS=()
build_jvmopts

# Runs the Gradle wrapper in the project directory, while the JVM later runs in the caller's directory so output files
# such as jHiccup logs land where the user expects them.
#
# The JVM option variables are removed because they are aimed at the workload, not at Gradle: they would reach the
# Gradle client and daemon, where a flag that needs our unlock options makes Gradle fail to start and a -javaagent such
# as jHiccup would load into the build.
#
# The wrapper client needs a JDK to start on, which it takes from JAVA_HOME or else from `java` on PATH. When the user
# picked the JDK with JAVABIN alone, PATH may have no usable java (on macOS it is often a stub), so the wrapper gets
# the selected JDK's home instead. Either way the daemon that does the actual build runs on the JDK pinned in
# gradle/gradle-daemon-jvm.properties, so this only affects the short-lived client.
GRADLE_JAVA_HOME="${JAVA_HOME:-$(echo "$JAVA_SETTINGS" | java_property java.home)}"
gradle_ws () {
    (CDPATH= cd -- "$SCRIPT_DIR" &&
        env -u _JAVA_OPTIONS -u JAVA_TOOL_OPTIONS -u JDK_JAVA_OPTIONS JAVA_HOME="$GRADLE_JAVA_HOME" ./gradlew "$@")
}

gradle_ws --quiet :app:installDist >&2

# The quoted `lib/*` is a JVM classpath wildcard (every jar in the directory), not a shell glob.
exec "$JAVA" "${JVMOPTS[@]}" -cp "$INSTALL_LIB/*" "$MAIN_CLASS" "$@"
